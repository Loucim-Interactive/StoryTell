  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Systems.InspectionSystem.Scripts.InspectableDocument
  title: Carta desde las islas
  transcription: "28 de mayo, Islas Malvinas\n\nMam\xE1:\n\xBFC\xF3mo est\xE1n all\xE1?
    Ac\xE1 todo bien, no se preocupen. Hace fr\xEDo, pero entre todos nos arreglamos.\nContame
    c\xF3mo est\xE1 el perro, si extra\xF1a que no est\xE9. Los quiero mucho, decile
    a pap\xE1 que se\u2026\n\n[El fragmento termina aqu\xED.]"
  inspectionOffset: {x: -0.18, y: 0, z: 0}
  inspectionEulerAngles: {x: -65, y: 0, z: 0}
  inspectionSize: 0.43
  hideAfterInspection: 0
