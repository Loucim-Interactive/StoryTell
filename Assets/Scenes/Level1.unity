--- !u!114 &261744520
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 261744518}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b6794d40d99ce9e45a232d202b68dde0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Systems.InspectionSystem.Scripts.InspectableDocument
  title: "Carta de Lan\xFAs \xB7 20 de abril"
  transcription: "Lan\xFAs, 20 de abril\nQuerido Marcos:\n\nNo sab\xE9s la alegr\xEDa
    que nos dio cuando el cartero trajo tu carta. La le\xED cuatro veces y se la
    le\xED a toda la cuadra. Do\xF1a Pepa me dijo que prendiera una vela a la Virgen
    y ya la tengo prendida desde que te fuiste.\n\nAc\xE1 no se habla de otra cosa.
    En la tele pasan marchas y\u2026 [pasaje tachado en el recurso]. Tu pap\xE1 es
    de callar, y ya sab\xE9s c\xF3mo es, pero anoche lo vi sentado en tu cuarto,
    a oscuras; de vez en cuando arregla nuevamente el foquito de la mesa de luz.\n\nTe
    mando las medias que te tej\xED, la yerba y unos alfajores. No s\xE9 si te van
    a llegar, pero lo mando igual. Com\xE9 todo lo que te den y abrigate, no te hagas
    el guapo.\n\nLo \xFAnico que pedimos todos los d\xEDas es que vuelvas.\n\nTe
    lo manda con cari\xF1o,\nTu mam\xE1"
  inspectionOffset: {x: -0.18, y: 0, z: 0}
  inspectionEulerAngles: {x: -65, y: 0, z: 0}
  inspectionSize: 0.43
  hideAfterInspection: 1
