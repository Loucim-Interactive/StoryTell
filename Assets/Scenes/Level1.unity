  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Systems.InspectionSystem.Scripts.InspectableDocument
  title: "Cr\xF3nica \xB7 2 de abril de 1982"
  transcription: "Transcripci\xF3n de los titulares visibles del recurso:\n\nARGENTINAZO:\n\xA1LAS
    MALVINAS RECUPERADAS!\n\nACCI\xD3N CONJUNTA DE NUESTRAS FUERZAS ARMADAS; MARCHAN
    AVIONES Y BARCOS EN GRAN OPERATIVO; EL TIEMPO CONSPIRA.\n\nCr\xF3nica \xB7 Firme
    junto al pueblo\nViernes 2 de abril de 1982\nEdici\xF3n dominical $6.000\nRecargo
    v\xEDa a\xE9rea $100\n\nSe conservan las palabras del peri\xF3dico hist\xF3rico.
    El resto de la p\xE1gina se puede observar en el objeto; esta transcripci\xF3n
    no reproduce las columnas completas."
  inspectionOffset: {x: -0.18, y: 0, z: 0}
  inspectionEulerAngles: {x: -65, y: 0, z: 0}
  inspectionSize: 0.43
  hideAfterInspection: 0
